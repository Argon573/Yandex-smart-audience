APP_ENV=local
APP_NAME=Smart Classroom Control Plane API
DATABASE_URL=sqlite+aiosqlite:///./dev.db

JWT_SECRET=change-me-in-secret-storage
ACCESS_TTL=900
REFRESH_TTL=604800

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_PROVIDER_BASE_URL=http://localhost:8000/v1.0

POLL_INTERVAL_MS=2000
STEP_TIMEOUT_MS=3000
STEP_RETRIES=2
RUN_TIMEOUT_MS=60000
RUN_POLICY=continue_on_error

ALLOWLIST_VERSION=2026-10-27
ALLOWLIST_PATH=config/yandex_allowlist.yaml
SIMULATOR_SEED=42

LOG_LEVEL=INFO
